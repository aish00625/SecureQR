{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SecureQR: run web app",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "SecureQR: run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "SecureQR: retrain model (~20 min)",
      "type": "debugpy",
      "request": "launch",
      "module": "secureqr.ml.train",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
