# Copy to .env and adjust. Every value is optional.

# REQUIRED for production: a long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECUREQR_SECRET_KEY=change-me

SECUREQR_DEBUG=false
SECUREQR_HOST=127.0.0.1
SECUREQR_PORT=5000

# Paths (defaults shown)
# SECUREQR_DATABASE=instance/secureqr.db
# SECUREQR_MODEL_PATH=model/secureqr_model.joblib
# SECUREQR_METRICS_PATH=model/metrics.json
# SECUREQR_LOG_DIR=logs
SECUREQR_LOG_LEVEL=INFO

# Upload limits
SECUREQR_MAX_UPLOAD_MB=5
SECUREQR_MAX_IMAGE_PIXELS=40000000

# Rate limiting: requests per window (seconds) per client IP
SECUREQR_RATE_LIMIT_ENABLED=true
SECUREQR_RATE_LIMIT_WINDOW=60
SECUREQR_RATE_LIMIT_SCAN=30
SECUREQR_RATE_LIMIT_FRAME=150
SECUREQR_RATE_LIMIT_DEFAULT=120
# Only set true when running behind a reverse proxy you control
SECUREQR_TRUST_PROXY=false

# Set true when served over HTTPS (adds Secure cookie flag + HSTS)
SECUREQR_COOKIE_SECURE=false
